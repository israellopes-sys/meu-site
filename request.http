@baseUrl = http://localhost:3000

### 1. Cadastro válido — 201 + envio de e-mail
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
    "nome": "Usuario Teste",
    "email": "usuario.teste@email.com",
    "senha": "123456"
}

### 2. Cadastro inválido — 400
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
    "nome": "A",
    "email": "email-invalido",
    "senha": "123"
}

### 3. ID inválido — 400
GET {{baseUrl}}/musicas/abc

### 4. Query inválida — 400
GET {{baseUrl}}/musicas?nome=a

### 5. Recurso inexistente — 404
GET {{baseUrl}}/musicas/999999

### 6. E-mail duplicado — 409
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
    "nome": "Usuario Duplicado",
    "email": "usuario.teste@email.com",
    "senha": "123456"
}